rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own test, result and progress documents.
    match /users/{userId}/{kind}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && kind in ['tests', 'results', 'progress'];
    }
  }
}
